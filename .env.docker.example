APP_ENV=production
APP_NAME=合家美宅客资平台
APP_VERSION=1.2.1
APP_IMAGE=registry.example.com/zhongshu-lead-platform:1.2.1@sha256:replace-with-reviewed-image-digest
LOG_LEVEL=INFO
LOG_JSON=true
AUTO_CREATE_SCHEMA=false
LEGACY_WRITE_ENABLED=false
APP_BASE_URL=https://app.example.com
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRE_MINUTES=1440
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_FAILURE_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15
POSTGRES_MAX_CONNECTIONS=100
DATABASE_POOL_SIZE=12
DATABASE_MAX_OVERFLOW=6
DATABASE_POOL_TIMEOUT_SECONDS=30
WEB_CONCURRENCY=5
SYNC_THREADPOOL_TOKENS=18
MAX_IN_FLIGHT_REQUESTS=18
IN_FLIGHT_QUEUE_TIMEOUT_SECONDS=10
SCHEDULER_DATABASE_POOL_SIZE=2
SCHEDULER_DATABASE_MAX_OVERFLOW=2
SCHEDULER_DATABASE_POOL_TIMEOUT_SECONDS=30
SCHEDULER_SYNC_THREADPOOL_TOKENS=4
FIELD_ENCRYPTION_KEY=replace-with-long-random-encryption-key
PHONE_HASH_SECRET=replace-with-long-random-phone-hash-secret
PHONE_FINGERPRINT_SECRET=replace-with-independent-phone-fingerprint-secret
LEAD_HARD_DUPLICATE_DAYS=90
LEAD_REWARD_DUPLICATE_DAYS=180
LEAD_HISTORICAL_SUSPECT_DAYS=365
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_OAUTH_SCOPE=snsapi_base
WECHAT_OAUTH_REDIRECT_URI=https://app.example.com/api/v1/auth/wechat/callback
WECHAT_DEV_MOCK=false
FEISHU_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_APP_TOKEN=
FEISHU_TABLE_ID=
FEISHU_FIELD_MAPPING_JSON=
FEISHU_SYNC_PAGE_SIZE=200
FEISHU_SYNC_MAX_PAGES=100
FEISHU_WRITEBACK_ENABLED=true
FEISHU_DEV_MOCK=false
OBJECT_STORAGE_BACKEND=s3
OBJECT_STORAGE_DIR=/app/storage
S3_ENDPOINT_URL=https://cos.ap-shanghai.myqcloud.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=ap-shanghai
CORS_ORIGINS=https://app.example.com
TRUSTED_HOSTS=app.example.com
LOW_POINTS_WARNING_THRESHOLD=1000
ASSIGNMENT_REMINDER_HOURS=24
ASSIGNMENT_EXPIRE_HOURS=48
FIRST_FOLLOWUP_HOURS=48
POSTGRES_DB=zhongshu
POSTGRES_USER=zhongshu
POSTGRES_PASSWORD=replace-database-password
HTTP_PORT=80
HTTPS_PORT=443
APP_DOMAIN=app.example.com
TRUSTED_PROXY_CIDR=127.0.0.1/32
# 生产拓扑的 nginx 会强制覆写 x-real-ip（见 infra/nginx/production.conf.template），
# 故部署侧也必须显式声明 true；容器内由 docker-compose.prod.yml 固定注入同名值。
TRUST_PROXY_HEADERS=true
BACKUP_RETENTION_DAYS=30
SEED_DEMO=false
