APP_ENV=production
APP_NAME=众墅之家客资平台
APP_BASE_URL=https://app.example.com
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRE_MINUTES=1440
FIELD_ENCRYPTION_KEY=replace-with-long-random-encryption-key
PHONE_HASH_SECRET=replace-with-long-random-phone-hash-secret
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_OAUTH_REDIRECT_URI=https://app.example.com/api/v1/auth/wechat/callback
WECHAT_DEV_MOCK=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_APP_TOKEN=
FEISHU_TABLE_ID=
FEISHU_DEV_MOCK=false
OBJECT_STORAGE_BACKEND=local
OBJECT_STORAGE_DIR=/app/storage
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=zhongshu-private
S3_REGION=ap-singapore-1
CORS_ORIGINS=https://app.example.com
LOW_POINTS_WARNING_THRESHOLD=1000
ASSIGNMENT_REMINDER_HOURS=24
ASSIGNMENT_EXPIRE_HOURS=48
RETURN_WINDOW_HOURS=48
FIRST_FOLLOWUP_HOURS=48
POSTGRES_DB=zhongshu
POSTGRES_USER=zhongshu
POSTGRES_PASSWORD=replace-database-password
HTTP_PORT=8080
SEED_DEMO=false
