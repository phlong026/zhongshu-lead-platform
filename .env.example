APP_ENV=development
APP_NAME=合家美宅客资平台
APP_VERSION=1.2.5
LOG_LEVEL=INFO
LOG_JSON=true
AUTO_CREATE_SCHEMA=true
APP_BASE_URL=http://localhost:8000
DATABASE_URL=sqlite:///./zhongshu.db
POSTGRES_MAX_CONNECTIONS=100
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30
LEAD_EXPORT_DATABASE_POOL_SIZE=2
LEAD_EXPORT_DATABASE_MAX_OVERFLOW=0
LEAD_EXPORT_DATABASE_POOL_TIMEOUT_SECONDS=30
LEAD_EXPORT_POLL_SECONDS=5
LEAD_EXPORT_ACTIVE_PER_USER_LIMIT=2
LEAD_EXPORT_ACTIVE_GLOBAL_LIMIT=20
LEAD_EXPORT_ROLLING_24H_PER_USER_LIMIT=10
WEB_CONCURRENCY=1
SYNC_THREADPOOL_TOKENS=40
MAX_IN_FLIGHT_REQUESTS=32
IN_FLIGHT_QUEUE_TIMEOUT_SECONDS=10
JWT_SECRET=dev-change-me-at-least-32-characters-long
JWT_EXPIRE_MINUTES=1440
FIELD_ENCRYPTION_KEY=dev-only-key-change-in-production
PHONE_HASH_SECRET=dev-phone-hash-secret
PHONE_FINGERPRINT_SECRET=dev-independent-phone-fingerprint-secret
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_OAUTH_SCOPE=snsapi_base
WECHAT_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/wechat/callback
WECHAT_DEV_MOCK=true
FEISHU_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_APP_TOKEN=
FEISHU_TABLE_ID=
FEISHU_VIEW_ID=
FEISHU_VIEW_NAME=客户视图
FEISHU_FIELD_MAPPING_JSON=
FEISHU_SYNC_PAGE_SIZE=200
FEISHU_SYNC_MAX_PAGES=100
FEISHU_WRITEBACK_ENABLED=false
FEISHU_DEV_MOCK=true
OBJECT_STORAGE_BACKEND=local
OBJECT_STORAGE_DIR=./storage
S3_ENDPOINT_URL=https://cos.ap-shanghai.myqcloud.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=ap-shanghai
CORS_ORIGINS=http://localhost:8000
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
# 仅当 API 前置会强制覆写 x-real-ip 的受信反向代理（如本仓库生产 nginx）时才设 true；
# 生产 docker-compose.prod.yml 的 api/scheduler/lead-export-worker 服务已固定注入 true，且生产启动
# 校验强制要求 true。客户端伪造的头绝不能充当身份（限流键、审计 IP 均依赖该开关）。
TRUST_PROXY_HEADERS=false
LEGACY_WRITE_ENABLED=true
LOW_POINTS_WARNING_THRESHOLD=1000
ASSIGNMENT_REMINDER_HOURS=24
ASSIGNMENT_EXPIRE_HOURS=48
PRE_DISPATCH_VERIFICATION_HOURS=24
RETURN_VERIFICATION_HOURS=24
RETURN_WINDOW_HOURS=48
FIRST_FOLLOWUP_HOURS=48
