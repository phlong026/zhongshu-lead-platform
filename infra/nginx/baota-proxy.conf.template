map $http_upgrade $connection_upgrade {
    default upgrade;
    '' '';
}

upstream zhongshu_api {
    server api:8000;
    keepalive 256;
}

# BaoTa terminates TLS and overwrites these headers before proxying to the
# loopback-only container gateway. Use that trusted value for rate limiting;
# the gateway port must never be exposed beyond 127.0.0.1.
map $http_x_real_ip $client_rate_key {
    default $http_x_real_ip;
    '' $binary_remote_addr;
}

limit_req_zone $client_rate_key zone=api_limit:10m rate=20r/s;
limit_req_zone $client_rate_key zone=auth_login_limit:10m rate=10r/m;
limit_conn_zone $client_rate_key zone=client_conn:10m;

server {
    listen 80;
    server_name ${APP_DOMAIN};

    include /etc/nginx/snippets/security-headers.conf;

    client_max_body_size 25m;
    client_body_timeout 60s;
    keepalive_timeout 65s;
    limit_conn client_conn 30;

    location = /health/live {
        proxy_pass http://zhongshu_api/health/live;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        access_log off;
    }

    location = /health/ready {
        proxy_pass http://zhongshu_api/health/ready;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        access_log off;
    }

    location = /api/v1/auth/login {
        limit_req zone=auth_login_limit burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://zhongshu_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $http_x_real_ip;
        proxy_set_header X-Forwarded-For $http_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Request-ID $request_id;
        proxy_connect_timeout 10s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
    }

    location /api/ {
        limit_req zone=api_limit burst=40 nodelay;
        proxy_pass http://zhongshu_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $http_x_real_ip;
        proxy_set_header X-Forwarded-For $http_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_connect_timeout 10s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
    }

    location / {
        proxy_pass http://zhongshu_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $http_x_real_ip;
        proxy_set_header X-Forwarded-For $http_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Request-ID $request_id;
        proxy_connect_timeout 10s;
        proxy_read_timeout 120s;
    }
}
